{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["latest", "head", "canary"]
          }
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "progressDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "automountServiceAccountToken"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["dns", "ui"],
      "properties": {
        "dns": {
          "type": "object",
          "required": ["name", "type", "externalTrafficPolicy", "port"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": ["LoadBalancer", "NodePort", "ClusterIP"]
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": ["Cluster", "Local"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "encryptedPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "ui": {
          "type": "object",
          "required": ["name", "type", "port", "targetPort"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targetPort": {
              "type": ["string", "integer"]
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "name", "hosts"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "minItems": 1
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "adguardConfig": {
      "type": "object",
      "properties": {
        "dns": {
          "type": "object"
        }
      }
    },
    "forwardAuth": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "trustForwardHeader": {
          "type": "boolean"
        },
        "authResponseHeaders": {
          "type": "array"
        }
      }
    },
    "dohIngress": {
      "type": "object",
      "required": ["enabled", "name", "host", "path"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "tls": {
          "type": "object"
        }
      }
    },
    "encryption": {
      "type": "object",
      "required": ["enabled", "serverName", "secretName", "mountPath", "certificateFile", "privateKeyFile"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serverName": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "mountPath": {
          "type": "string"
        },
        "certificateFile": {
          "type": "string"
        },
        "privateKeyFile": {
          "type": "string"
        },
        "forceHttps": {
          "type": "boolean"
        },
        "strictSniCheck": {
          "type": "boolean"
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "claimName", "accessModes", "size"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "claimName": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
