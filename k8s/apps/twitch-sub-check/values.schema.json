{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "watch": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKeys": {
          "type": "object",
          "properties": {
            "twitchClientId": { "type": "string", "minLength": 1 },
            "twitchClientSecret": { "type": "string", "minLength": 1 },
            "telegramBotToken": { "type": "string", "minLength": 1 },
            "telegramChatId": { "type": "string", "minLength": 1 }
          }
        },
        "values": {
          "type": "object",
          "properties": {
            "twitchClientId": { "type": "string", "minLength": 1 },
            "twitchClientSecret": { "type": "string", "minLength": 1 },
            "telegramBotToken": { "type": "string", "minLength": 1 },
            "telegramChatId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "databaseUrl": { "type": "string", "minLength": 1 },
        "databaseEcho": { "type": "string" },
        "reportCron": { "type": "string", "minLength": 1 },
        "rabbitmqExchange": { "type": "string", "minLength": 1 },
        "rabbitmqQueue": { "type": "string" },
        "rabbitmqPrefetch": { "type": "integer", "minimum": 1 },
        "pythonUnbuffered": { "type": "string" },
        "pythonDontWriteBytecode": { "type": "string" }
      }
    },
    "eventBus": {
      "type": "object",
      "properties": {
        "rabbitmq": {
          "type": "object",
          "properties": {
            "externalUrl": { "type": "string" },
            "externalUrlSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "resources": { "type": "object" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "egress": { "type": "array" },
        "ingress": { "type": "array" }
      }
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "secretKeys": {
              "type": "object",
              "properties": {
                "username": { "type": "string", "minLength": 1 },
                "password": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "managementPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "size": { "type": "string", "minLength": 1 },
            "annotations": { "type": "object" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
